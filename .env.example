# Hardhat environment variables. Copy this file to .env and fill in values.
# .env is ignored by git; never commit a funded private key.

# Deployment / upgrade account.
PRIVATE_KEY=

# RPC overrides. Public defaults are built into hardhat.config.js.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# BSC_TEST_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# ARB_RPC_URL=https://arb1.arbitrum.io/rpc
# ARB_TEST_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# ROBINHOOD_TEST_RPC_URL=https://rpc.testnet.chain.robinhood.com
# LOCAL_RPC_URL=http://127.0.0.1:8545

# Per-network economic parameters. Use the network prefix:
# BSC_*, BSC_TEST_*, SEPOLIA_*, ARB_*, ARB_TEST_*, ROBINHOOD_*, ROBINHOOD_TEST_*.
# Example for BSC:
# BSC_CFG_START_TIME=1719698400
# BSC_CFG_DECREASE_COEFFICIENT=1.04491013
# BSC_CFG_TOTAL_SUPPLY_BY_DAY=888
# BSC_CFG_MINT_PRICE=0.002
# BSC_FORTUNE_STICK_BASE_URI=https://metadata.example.com
# BSC_FORTUNE_STICK_FINAL_BASE_URI=https://metadata.example.com/path

# scripts/set-params.js
# SET_MINT_PRICE=0.002
# CFG_PROXY_ADDRESS=

# scripts/upgrade.js
# NEW_IMPL_ADDRESS=
# EXPECTED_IMPL_ADDRESS=
# PROXY_ADMIN_ADDRESS=
# UPGRADE_REASON=
# CONFIRM_UPGRADE=true

# scripts/exportManifest.js
# CHAIN_EXPIRES_AT=2027-01-01T00:00:00Z
# MANIFEST_VERSION=1
# DEPLOYMENT_ID=bsc-v2
# CHAIN_STATUS=read_only
# CHAIN_NAME=BNB Smart Chain
# CHAIN_SYMBOL=BNB
# PUBLIC_RPC_URL=https://bsc-dataseed.bnbchain.org
# BLOCKCHAIN_CONFIRMATIONS=6
# DEPLOYMENT_VALID_FROM_BLOCK=0
# ABI_VERSION=v2
# CODE_VERSION=CyberFortuneGod@0.2
# CONFIG_VERSION=bsc-2
# BUILD_COMMIT=
# MANIFEST_OUTPUT=deployments/bsc/manifest.json

# Block explorer API key for hardhat-verify (Etherscan V2).
# ETHERSCAN_API_KEY=
